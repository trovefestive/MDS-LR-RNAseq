# Whitelist: ignore everything, then allow code, docs, and small result files.
# Never tracked: raw_files/, data/ (refs, indexes, paper code), BAMs, ESPRESSO/IsoQuant work dirs, logs, tmp/.
/*
!/.gitignore
!/README.md
# ANALYSIS_PLAN.md is local-only (not pushed): ignored by the /* rule above
!/CLAUDE.md
!/config.sh
!/samples.tsv
!/scripts/
!/results/
/results/*
!/results/reports/
!/results/metadata/
!/results/01_align/
/results/01_align/bam/
*.bam
*.bai
*.mmi
.DS_Store
._*
# Phase 2: only small summaries + gzipped matrix (merged GTF, work dirs, IsoQuant output stay local)
!/results/02_espresso/
/results/02_espresso/*
!/results/02_espresso/phase2_*.tsv
!/results/02_espresso/merged_N2_R0_abundance.esp.gz
# Phase 3: summaries, plots, final matrices (QC/filter/quant/compare dirs stay local)
!/results/03_sqanti/
/results/03_sqanti/*
!/results/03_sqanti/phase3_*
!/results/03_sqanti/filter_*_counts.tsv
!/results/03_sqanti/final/
